<Window x:Class="CavernizeAutomate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CavernizeAutomate"
        mc:Ignorable="d"
        Title="Cavernize Automate" Height="450" Width="800" WindowStartupLocation="CenterScreen" Icon="/1.ico">
    <Window.CommandBindings>
        <CommandBinding Command="local:MainWindow.SelectCavernizeAppCommand" Executed="SelectCavernizeAppCommand_Executed"  CanExecute="InputCommands_CanExecute"/>
        <CommandBinding Command="local:MainWindow.SelectFilesToProcessCommand" Executed="SelectFilesToProcess_Executed" CanExecute="InputCommands_CanExecute"/>
        <CommandBinding Command="local:MainWindow.SelectOutputFolderCommand" Executed="SelectOutputFolder_Executed" CanExecute="InputCommands_CanExecute"/>
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="6,0,6,0">Location of Cavernize app (CavernizeGUI.exe):</Label>
        <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="10,23,10,0" Height="20" IsReadOnly="True" Text="{Binding Path=LocationOfCavernizeApp}"></TextBox>
        <Button Grid.Row="0" Grid.Column="2" VerticalAlignment="Top" Margin="6,23,10,0" Height="25" Command="local:MainWindow.SelectCavernizeAppCommand">Browse</Button>

        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="6,0,6,0">Files to process:</Label>
        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="10,23,10,0" Height="40" IsReadOnly="True" Text="{Binding Path=FilesToProcessMsg, Mode=OneWay}"></TextBox>
        <Button Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Margin="6,23,10,0" Height="25" Command="local:MainWindow.SelectFilesToProcessCommand">Browse</Button>

        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="6,75,6,0">Output folder:</Label>
        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="10,98,10,0" Height="20" IsReadOnly="True" Text="{Binding Path=OutputFolder}"></TextBox>
        <Button Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Margin="6,98,10,0" Height="25" Command="local:MainWindow.SelectOutputFolderCommand">Browse</Button>

        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="6,130,6,0">Output file format:</Label>
        <ComboBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,135,6,0" Width="125" ItemsSource="{Binding Path=OutputFileFormatList}" SelectedItem="{Binding Path=OutputFileFormat, Mode=TwoWay}"></ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6,135,6,0" Height="20">
            <Hyperlink NavigateUri="{Binding Path=CavernizeDocsUrl}" RequestNavigate="Hyperlink_RequestNavigate">Cavernize documentation</Hyperlink>
        </TextBlock>

        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="6,162,6,0">Output render format:</Label>
        <ComboBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,167,6,0" Width="125" ItemsSource="{Binding Path=OutputRenderFormatList}" SelectedItem="{Binding Path=OutputRenderFormat, Mode=TwoWay}"></ComboBox>

        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="6,194,6,0">24 bit:</Label>
        <CheckBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="6,199,6,0" IsChecked="{Binding Path=TwentyFourBit}"></CheckBox>

        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="6,226,6,0">Gain dB:</Label>
        <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,226,6,0" Height="20" Width="35" Text="{Binding Path=GainDb}"></TextBox>

        <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="6,0,6,0">Processing:</Label>
        <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="10,23,10,10" Height="40" IsReadOnly="True" Text="{Binding Path=ProcessingMsg}"></TextBox>
        <Button Grid.Row="2" Grid.Column="2" VerticalAlignment="Top" Margin="6,23,10,0" Height="25" Command="{Binding ProcessFilesCommand}">Process</Button>
        <Button Grid.Row="2" Grid.Column="2" VerticalAlignment="Top" Margin="6,58,10,10" Height="25" Command="{Binding ProcessFilesCancelCommand}">Cancel</Button>

    </Grid>
</Window>
